# Copie para .env (local) e NUNCA faça commit do .env.
# Na Vercel, cadastre estas variáveis em Settings > Environment Variables.

# Chave que o ESP32 envia no cabeçalho X-API-Key. Gere uma aleatória e longa:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ESTACAO=

# Calibração do pluviômetro (funil + tubo + HC-SR04)
DISTANCIA_VAZIO_CM=20
DIAMETRO_FUNIL_MM=110
DIAMETRO_RECIPIENTE_MM=40

# Leitura bruta do MQ-135 em ar limpo, após pré-aquecimento (0 a 4095)
MQ135_BASE_BRUTO=600
